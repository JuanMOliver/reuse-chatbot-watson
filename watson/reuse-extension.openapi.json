{
  "openapi": "3.0.3",
  "info": {
    "title": "ReUse — Watson Custom Extension",
    "version": "1.1.0",
    "description": "Ações reais sobre o inventário demonstrativo ReUse. Servidor próprio HTTPS e chave de extensão obrigatórios. Confirmação de ações destrutivas deve ocorrer no fluxo conversacional antes de invocar POST."
  },
  "servers": [
    {
      "url": "https://SUBSTITUA-PELA-URL-DO-SERVIDOR.example"
    }
  ],
  "components": {
    "securitySchemes": {
      "ExtensionKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-reuse-extension-key",
        "description": "Chave armazenada no IBM como segredo; nunca publicar no GitHub."
      }
    },
    "schemas": {
      "Offer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "TradeRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "with": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "active": {
            "type": "integer"
          },
          "paused": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "requests": {
            "type": "integer"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "ActionResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "affected": {
            "type": "integer"
          },
          "activeCount": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "ExtensionKey": []
    }
  ],
  "paths": {
    "/api/extension/items": {
      "get": {
        "operationId": "listOffers",
        "summary": "Consultar ofertas ativas e pausadas",
        "responses": {
          "200": {
            "description": "Inventário do usuário demonstrativo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Offer"
                      }
                    },
                    "summary": {
                      "$ref": "#/components/schemas/Summary"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chave inválida"
          }
        }
      }
    },
    "/api/extension/trades": {
      "get": {
        "operationId": "listTradeRequests",
        "summary": "Consultar solicitações de troca",
        "responses": {
          "200": {
            "description": "Solicitações e estados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "requests": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TradeRequest"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chave inválida"
          }
        }
      }
    },
    "/api/extension/items/pause-all": {
      "post": {
        "operationId": "pauseAllOffers",
        "summary": "Pausar todas as ofertas — solicitar confirmação antes desta chamada",
        "responses": {
          "200": {
            "description": "Quantidade de anúncios afetados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "401": {
            "description": "Chave inválida"
          }
        }
      }
    },
    "/api/extension/items/resume-all": {
      "post": {
        "operationId": "resumeAllOffers",
        "summary": "Reativar todas as ofertas — solicitar confirmação antes desta chamada",
        "responses": {
          "200": {
            "description": "Quantidade de anúncios afetados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActionResult"
                }
              }
            }
          },
          "401": {
            "description": "Chave inválida"
          }
        }
      }
    }
  }
}
