# Renomeie para .env; não publique credenciais.
PORT=3000
ASSISTANT_MODE=demo
# Alternativa sem cartão: altere para granite após instalar Ollama e modelo
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=granite3.3:2b
IBM_WATSON_APIKEY=
IBM_WATSON_URL=https://api.us-south.assistant.watson.cloud.ibm.com
IBM_WATSON_ENVIRONMENT_ID=
IBM_WATSON_VERSION=2024-08-25
EXTENSION_API_KEY=change-this-before-deployment
